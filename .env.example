# Copy to `.env` and fill in. Never commit `.env`.

# --- Oracle (KMITL Data Warehouse, schema AI03) ---
ORACLE_HOST=161.246.35.92
ORACLE_PORT=1521
ORACLE_SERVICE=orcl
ORACLE_USER=AI03
ORACLE_PASSWORD=
# Absolute or repo-relative path to the JDBC driver.
ORACLE_JDBC_JAR=db_module/db_conn/oracle/drivers/ojdbc8.jar
# macOS brew install path — override per machine if different.
JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home

# --- Supabase (OLTP — cloud Postgres) ---
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=
# Leave SUPABASE_SSLMODE=require for Supabase cloud; set to `disable` for local dev.
SUPABASE_SSLMODE=require

# --- InfluxDB 2.x (hosted on AWS) ---
INFLUX_URL=
INFLUX_ORG=factory
INFLUX_TOKEN=
INFLUX_BUCKET=sensors

# --- Oracle API service (FastAPI wrapper at app/api/) ---
# Airflow DAGs call this service instead of talking to Oracle directly —
# avoids needing Java + ojdbc8.jar inside the Airflow container.
ORACLE_API_URL=http://localhost:8000
ORACLE_API_TOKEN=
